{
  "name": "@catpula/axe",
  "version": "0.1.0",
  "description": "BYOK CLI coding agent. Small core, real tools, no scaffolding.",
  "type": "module",
  "bin": { "axe": "./src/cli.ts" },
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node --experimental-strip-types src/cli.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "node --experimental-strip-types scripts/smoke.ts",
    "args-test": "node --experimental-strip-types scripts/args-test.ts",
    "errors-test": "node --experimental-strip-types scripts/errors-test.ts",
    "prompt-test": "node --experimental-strip-types scripts/prompt-test.ts",
    "doctor-test": "node --experimental-strip-types scripts/doctor-test.ts",
    "recovery-test": "node --experimental-strip-types scripts/recovery-test.ts",
    "reliability-test": "node --experimental-strip-types scripts/reliability-test.ts",
    "compact-test": "node --experimental-strip-types scripts/compact-test.ts",
    "loop-test": "node --experimental-strip-types scripts/loop-test.ts",
    "adapter-test": "node --experimental-strip-types scripts/adapter-test.ts",
    "subagent-test": "node --experimental-strip-types scripts/subagent-test.ts",
    "skills-test": "node --experimental-strip-types scripts/skills-test.ts",
    "agents-test": "node --experimental-strip-types scripts/agents-test.ts",
    "plugin-test": "node --experimental-strip-types scripts/plugin-test.ts",
    "mcp-test": "node --experimental-strip-types scripts/mcp-test.ts",
    "tools-test": "node --experimental-strip-types scripts/tools-test.ts",
    "skill-add-test": "node --experimental-strip-types scripts/skill-add-test.ts",
    "skill-mcp-test": "node --experimental-strip-types scripts/skill-mcp-test.ts",
    "review-test": "node --experimental-strip-types scripts/review-test.ts",
    "tui-test": "node --experimental-strip-types scripts/tui-test.ts",
    "editor-test": "node --experimental-strip-types scripts/editor-test.ts",
    "screen-test": "node --experimental-strip-types scripts/screen-test.ts",
    "config-test": "node --experimental-strip-types scripts/config-test.ts",
    "schedules-test": "node --experimental-strip-types scripts/schedules-test.ts",
    "permissions-test": "node --experimental-strip-types scripts/permissions-test.ts",
    "web-search-test": "node --experimental-strip-types scripts/web-search-test.ts",
    "clipboard-test": "node --experimental-strip-types scripts/clipboard-test.ts",
    "cli-test": "node --experimental-strip-types scripts/cli-test.ts",
    "release-test": "node --experimental-strip-types scripts/release-test.ts",
    "live-test": "node --experimental-strip-types scripts/live-test.ts",
    "test": "npm run typecheck && npm run smoke && npm run args-test && npm run errors-test && npm run prompt-test && npm run compact-test && npm run loop-test && npm run adapter-test && npm run subagent-test && npm run skills-test && npm run agents-test && npm run plugin-test && npm run mcp-test && npm run skill-mcp-test && npm run tools-test && npm run skill-add-test && npm run review-test && npm run tui-test && npm run editor-test && npm run screen-test && npm run config-test && npm run doctor-test && npm run recovery-test && npm run reliability-test && npm run schedules-test && npm run permissions-test && npm run web-search-test && npm run clipboard-test && npm run cli-test && npm run release-test",
    "build": "bun build --compile --minify src/cli.ts --outfile dist/axe",
    "release": "node --experimental-strip-types scripts/release.ts"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^6.0.3"
  },
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Catpula/axe.git" },
  "bugs": { "url": "https://github.com/Catpula/axe/issues" },
  "homepage": "https://github.com/Catpula/axe#readme",
  "keywords": ["cli", "coding-agent", "llm", "anthropic", "openai", "gemini", "mcp", "byok"],
  "files": ["src", "examples", "README.md", "LICENSE"]
}
